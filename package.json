{
  "name": "arena",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"npm:server\"",
    "web": "vite",
    "dev:offline": "LLM_PROVIDER=offline npm run dev",
    "server": "tsx src/server/index.ts",
    "server:offline": "LLM_PROVIDER=offline tsx src/server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "esbuild src/server/prod.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs --log-level=warning --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "NODE_ENV=production tsx src/server/prod.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "concurrently": "^10.0.5",
    "hono": "^4.13.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
