# Настройки сервера. Все необязательные: без ключей игра работает офлайн (правила и заготовки), без голоса.
# Разметка и реплики — Claude Sonnet 5.5 через AITunnel (запасной — YandexGPT 5.1 Pro, для разметки потом правила),
# голос — ElevenLabs через свой воркер (запасной — Yandex SpeechKit), распознавание — потоковый Scribe, если настроен воркер, иначе SpeechKit.

# Базовая комплектация — полностью российский контур: YandexGPT 5.1 Pro + SpeechKit. Включается одной настройкой:
# KIT=base                              # только Яндекс: AITunnel, ElevenLabs и Scribe выключены, даже если ключи заданы

# ---------- Модели ----------
# Основная модель: yandex | aitunnel[:модель] | offline. Если ключей нет или модель падает, ход размечают правила.
LLM_PROVIDER=offline

# YandexGPT (ai.api.cloud.yandex.net, OpenAI-совместимый). Тот же ключ — для SpeechKit (роли ai.speechkit-tts.user и -stt.user)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1              # Pro; локально дешевле yandexgpt-lite. Можно полный gpt://<folder>/<model>
# YANDEX_ANALYZE_MODEL=yandexgpt-5.1    # разметка Яндексом (запасная у Claude и основная при ANALYZE_LLM=main); Lite путает условия
# YANDEX_FALLBACK_MODEL=yandexgpt-lite  # на неё сервер переходит с 80% общего бюджета
# YANDEX_URL=https://ai.api.cloud.yandex.net/v1/chat/completions

# AITunnel (aitunnel.ru): Claude, GPT, Gemini за рубли, с нашего сервера отвечает. Цена хода — из ответа (usage.cost_rub).
# AITUNNEL_API_KEY=
# AITUNNEL_MODEL=claude-sonnet-5.5      # для LLM_PROVIDER=aitunnel и лаборатории
# AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
# AITUNNEL_REASONING=                   # minimal | none | off; по умолчанию рассуждение выключается по модели
# AITUNNEL_PROVIDER=                    # у кого брать модель (OpenRouter): Claude по умолчанию — google-vertex (быстрее начинает); off — как решит OpenRouter
# LLM_LOG_CACHE=                        # 1 — в журнал: сколько промпта взято из кэша и цена каждого ответа AITunnel

# Модели по задачам, «провайдер:модель» (aitunnel:claude-sonnet-5.5, yandex:yandexgpt-5.1, yandex-lite, offline)
# VOICE_LLM=aitunnel:claude-sonnet-5.5  # реплика собеседника; так по умолчанию, если есть AITUNNEL_API_KEY. main — всё на основной
# ANALYZE_LLM=                          # разметка; без неё — Claude Sonnet 5.5 (если есть AITUNNEL_API_KEY), запасной — YandexGPT;
#                                       # main — Яндексом (YANDEX_ANALYZE_MODEL или основная), и английские дела тоже
# ANALYZE_LLM_EN=                       # разметка дел на английском; без неё — как ANALYZE_LLM
# ANALYZE_TIMEOUT_MS=4000               # сколько ждать Claude; не ответил или ответил не по схеме — размечает YandexGPT
# VOICE_LLM_ALLOWED=                    # список моделей реплики через запятую для ?llm= и x-voice-llm; по умолчанию Sonnet 5.5, GPT-6.1 Sol, YandexGPT Pro
# SPECULATE=                            # off — реплика только после разметки; по умолчанию модель пишет её сразу по разбору правил и
#                                       # берёт, если разметка дала ту же рамку (примерно в половине ходов)
# ANALYZE_QUICK=                        # off — без быстрой разметки; по умолчанию запасной Claude (YandexGPT Pro, ~0,8 с) размечает
#                                       # параллельно: сошёлся с правилами — начало реплики звучит, не дожидаясь Claude
# ANALYZE_RACE_TIMEOUT_MS=3000          # сколько ждать Claude, когда быстрая разметка уже есть
# PREPARE=                              # off — без заготовки хода по раннему тексту Scribe (/api/prepare)
# PREPARE_SESSION_MINUTE_LIMIT=20       # заготовок в минуту на сессию

# Бюджет: общий счёт на модели и голос с первого запуска (CACHE_DIR/usage/total.json).
# С 80% — запасная модель Яндекса, со 100% — офлайн и без голоса.
# LLM_TOTAL_RUB=6000
# LLM_DAILY_RUB=                        # суточный бюджет на модели, по умолчанию без лимита
# YANDEX_PRICE_IN=0.8                   # ₽ за 1000 токенов Pro (и AITunnel, если он не прислал цену)
# YANDEX_PRICE_OUT=0.8
# YANDEX_LITE_PRICE_IN=0.2
# YANDEX_LITE_PRICE_OUT=0.2

# Сколько ждать, мс. Модель зависла три раза подряд — 2 минуты ход идёт запасным путём.
# LLM_TIMEOUT_MS=25000                  # потолок любого запроса к модели
# VOICE_TIMEOUT_MS=8000                 # модель реплики; не успела — пишет основная

# ---------- Голос ----------
# Пилот в Алабуге: SpeechKit, без TTS_PROVIDER и ELEVEN_RELAY_*, STT_STREAM=off.
# ElevenLabs — для экспортной/английской версии в поддерживаемых регионах.
# Основной голос — ElevenLabs через свой воркер Cloudflare (из РФ ElevenLabs закрыт, ключ живёт только в воркере).
# Цепочка ElevenLabs → SpeechKit: без воркера, при лимите, очереди, медленном ответе или после трёх сбоев подряд
# (пауза 5 минут) говорит SpeechKit. Голос OpenAI на проде запрещён: другие TTS_PROVIDER игра не берёт.
# ElevenLabs озвучивает только тексты, которые выдал сервер: реплики хода и вступления дел.
# Кто кем говорит — CAST в src/server/tts.ts; вступления и фразы-паузы записаны заранее (scripts/eleven-known.ts).
# TTS_PROVIDER=elevenlabs
# ELEVEN_RELAY_URL=https://tts-relay.nigo57.workers.dev
# ELEVEN_RELAY_SECRET=                  # x-relay-secret воркера
# ELEVENLABS_MODEL=eleven_v4_turbo      # живые реплики; заготовки — eleven_v4
# ELEVEN_LIVE_V3=                       # on — живые реплики Эмре и Ли Вэя на eleven_v3 (акцент сильнее, первый звук на ~0,5 с позже);
#                                       # по умолчанию — ELEVENLABS_MODEL тем же голосом, вступление и реакции — v3
# ELEVEN_STABILITY=0.6                  # базовая стабильность; настройки отдельных лиц в tts.ts имеют приоритет
# ELEVEN_SIMILARITY=0.8                 # базовое сходство тембра; настройки лица имеют приоритет
# ELEVEN_CONCURRENCY=5                  # синтезов одновременно, сколько даёт тариф (Creator — 5, PAYG — 3); остальные ждут
# ELEVEN_FIRST_BYTE_MS=2500             # не начал отвечать — игрок слышит SpeechKit (браузер ждёт звук 4 с), звук ляжет в кэш
# ELEVEN_TIMEOUT_MS=15000               # синтез целиком (новый голос в первый раз грузится 8–9 с)
# ELEVEN_DAILY_CHARS=20000              # символов в сутки, включая резерв очереди; повторы из кэша не считаются
# Полный поздний звук (и его фрагменты) сохраняется отдельно от SpeechKit. Обрезки в кэш не попадают.
# ELEVEN_SESSION_HOUR_LIMIT=60          # синтезов в час на вход
# ELEVEN_IP_DAY_LIMIT=300               # синтезов в сутки на пропуск; общий потолок IP ×10
# TTS_CAST=sosed:<voice_id>             # переопределить голос лица
# TTS_PRICE_1K_RUB=                     # ₽ за 1000 символов в бюджет; по умолчанию Turbo 8, полная модель 16
# ELEVENLABS_API_KEY=                   # напрямую, без воркера — только для проверки с мака

# SpeechKit: голос по умолчанию и запасной, распознавание речи
# SPEECH=off                            # выключить голос и распознавание
# TTS_YANDEX_API=v1                     # озвучка через v1 (по умолчанию v3; новые голоса есть только в v3)
# NATURAL_SPEECH=voices+                # голоса livetts у лиц + ударения и паузы; voices — без разметки; on/live — режиссёр речи
# TTS_IP_DAY_LIMIT=                     # фраз SpeechKit на пропуск в сутки, по умолчанию без лимита
# STT_IP_DAY_LIMIT=                     # распознаваний на пропуск в сутки
# SPEECH_DAY_LIMIT=                     # того и другого на весь сервер в сутки
# TTS_DAILY_CHARS=                      # символов озвучки в сутки
# STT_DAILY_SEC=                        # секунд распознавания в сутки
# TTS_PRICE_250=0.1626                  # ₽ за начатые 250 символов SpeechKit v3
# LIVETTS_PRICE_250=0.25                # ₽ за начатые 250 символов livetts
# STT_PRICE_15S=0.1626                  # ₽ за 15 с распознавания

# Ударения (словарь src/content/stress-dict.ts): SpeechKit получает «+», ElevenLabs — знак ударения
# STRESS_MARK=risky                     # только разобранные поштучно слова; по умолчанию — все слова словаря
# STRESS_LLM=off                        # омографы, которые не решили правила, — без YandexGPT Lite (тогда вариант по умолчанию)
# STRESS_LLM_MS=500                     # сколько ждать её ответа
# STRESS_LLM_MODEL=yandexgpt-lite

# ---------- Лимиты ----------
# TURN_SESSION_MINUTE_LIMIT=20          # ходов в минуту на вход (без модели ход бесплатный и не считается)
# GENERATE_SESSION_DAY_LIMIT=20         # сборок своего дела моделью в сутки на вход, дальше — дело из библиотеки
# LAB_IP_DAY_LIMIT=200                  # ходов на чужой модели (лаборатория, ?llm=) на пропуск в сутки
# LAB=off                               # выключить лабораторию и выбор модели на запрос

# ---------- Сервер и ворота ----------
PORT=8787
# NODE_ENV=production                   # npm start и Docker задают сами; влияет на статику голосования и предупреждение о воротах
# PASSENGER_APP_ENV=production          # задаёт Passenger; также включает предупреждение о воротах
# CACHE_DIR=.cache                      # кэш разметки, реплик, озвучки, свои дела, комнаты, счёт бюджета
# Ворота прототипа: без GATE_SECRET сервер лишь предупреждает и оставляет сайт открытым.
# X-Forwarded-For учитывается только от этих адресов ближайшего прокси (через запятую).
# Без списка лимиты используют адрес сокета. Укажите реальные адреса своего прокси.
# TRUSTED_PROXIES=127.0.0.1,::1        # за Passenger (unix-сокет без адреса) — unix
# GATE_SECRET=                          # подпись пропуска
# JURY_KEY=                             # общий ключ ?key=, отдельный пропуск на каждый вход
# JURY_KEYS=                            # имя:ключ через запятую; случайные токены, генератор: npx tsx scripts/jury-keys.ts 2
# Битые записи JURY_KEYS пропускаются с предупреждением в журнале; первая корректная пара при дубликатах остаётся.
ADMIN_KEY=                              # отдельный ключ капитана: Bearer для GET /api/admin/jury
# Если старый ADMIN_KEY передавался в URL (?admin=), замените его; VOTE_ADMIN_KEY должен быть новым независимым секретом.
# Проверенный пропуск: квоты на человека, общий потолок IP ×10; анонимный трафик — обычная IP-квота.
# SITE_LOGIN=
# SITE_PASSWORD_HASH=                   # scrypt:<соль>:<хэш>, см. hashPassword в src/server/gate.ts

# Потоковый STT (Scribe): включён сам, если настроен воркер (ELEVEN_RELAY_*); STT_STREAM=off — только Яндекс.
# В браузере ?stt=off — только Яндекс, ?stt=scribe — поток принудительно (до закрытия вкладки).
# STT_STREAM=off
# По умолчанию браузер → сервер → воркер. Если Passenger не пропускает Upgrade — worker.
STT_STREAM_VIA=server
# Публичный origin без слеша; обязателен за HTTPS-прокси Passenger.
# STT_ORIGIN=https://your-domain.ru
# Использует ELEVEN_RELAY_URL и ELEVEN_RELAY_SECRET выше; ключ ElevenLabs только у воркера.
# STT_STREAM_SESSION_HOUR_LIMIT=120     # голосовой режим заранее открывает поток к концу реплики собеседника
# STT_STREAM_IP_DAY_LIMIT=300
# STT_SCRIBE_USD_HOUR=0.39
# USD_RUB=100                         # расчётный курс, обновлять вручную
# STT_DAILY_SEC ограничивает и Яндекс, и зарезервированные секунды Scribe.
# Scribe: заранее списывается слот 35 с (voiceonly/auto) или 65 с (кнопка), включая ожидание финала.
# Яндекс: каждая начатая попытка, включая хедж/отмену, по 15-секундным блокам.

# Семейное голосование за голоса: отдельная ссылка, не открывает игру.
# Случайные разные ключи; без VOTE_KEY страница выключена. Итоги требуют отдельный VOTE_ADMIN_KEY; ввод через форму, не через URL.
VOTE_KEY=
VOTE_ADMIN_KEY=
# votes.json лежит в CACHE_DIR; до 20 бланков с IP в сутки, до 2000 всего.
