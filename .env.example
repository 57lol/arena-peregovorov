# Копия этого файла в .env — только для ваших настроек; реальные секреты в Git не добавлять.
# Локально файл и ключи не обязательны: правила, заготовки, текстовый ввод, кабинет и доска.
# Production (npm start / Docker): непустой GATE_SECRET обязателен, без него запуск запрещён.
# Для входа настройте JURY_KEY / JURY_KEYS либо SITE_LOGIN + SITE_PASSWORD_HASH.

# ---------- Модели ----------
# Безопасное значение для проверки без ключей. Просто добавить ключи недостаточно — смените на yandex.
# Допустимы offline | yandex[:модель] | aitunnel[:модель] | anthropic[:модель].
LLM_PROVIDER=offline
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Рекомендуемый онлайн-режим: LLM_PROVIDER=yandex + оба поля Яндекса + AITUNNEL_API_KEY.
# Разметка: Sonnet 5.5 → YandexGPT 5.1 Pro → правила.
# Реплика: Sonnet 5.5 → основная модель (здесь Яндекс) → заготовка; заход — YandexGPT Pro.
YANDEX_MODEL=yandexgpt-5.1
# YANDEX_ANALYZE_MODEL=yandexgpt-5.1
# YANDEX_FALLBACK_MODEL=yandexgpt-lite    # с 80% бюджета, кроме запросов с обязательным Pro
# AITUNNEL_API_KEY=
# AITUNNEL_MODEL=claude-sonnet-5.5        # основная модель AITunnel и лаборатория
# Anthropic через тот же воркер; ключ Anthropic хранится ТОЛЬКО в переменных воркера.
# ANTHROPIC_VIA_RELAY=on                # автоматически разметка/реплика: Anthropic → AITunnel → Яндекс
# Нужны ELEVEN_RELAY_URL и ELEVEN_RELAY_SECRET (см. речь ниже).
# POST <ELEVEN_RELAY_URL без завершающего />/anthropic/v1/messages
# ANTHROPIC_BASE_URL=https://relay.example/anthropic/v1  # альтернативная база до /messages; тоже включает провайдер
# VOICE_LLM=anthropic:claude-sonnet-5-5   # явный выбор; дефисы в нативном ID Anthropic
# ANALYZE_LLM=anthropic:claude-sonnet-5-5 # также для английских дел, если ANALYZE_LLM_EN не задан
# Явные VOICE_LLM/ANALYZE_LLM (включая main) важнее автоматического выбора: замените старые значения.
# USD_RUB=100                           # внутренний курс для бюджета; тариф ANTHROPIC_PRICE в llm.ts — уточнить
# VOICE_LLM=aitunnel:claude-sonnet-5.5    # автоматический выбор при ключе AITunnel и включённой основной модели
# ANALYZE_LLM=aitunnel:claude-sonnet-5.5  # тот же автоматический выбор; main — разметка основной моделью
# ANALYZE_LLM_EN=                        # без значения — как ANALYZE_LLM
# VOICE_LLM=main                         # реплика основной моделью
# VOICE_LLM_ALLOWED=                     # разрешённые модели для ?llm= и x-voice-llm, через запятую
# KIT=base                              # принудительно Яндекс: модели и SpeechKit; отключает AITunnel, ElevenLabs, Scribe
# KIT=base переопределяет LLM_PROVIDER=offline, в том числе при npm run dev:offline.

# Параллельная подготовка хода и ранний заход; значения ниже отключают отдельные оптимизации.
# SPECULATE=off
# ANALYZE_QUICK=off
# OPENER=off
# OPENER_LLM=yandex:yandexgpt-5.1
# OPENER_SKIP=china,lagos                 # ID дел без захода, пример настройки
# PREPARE=off
# LLM_TIMEOUT_MS=25000
# VOICE_TIMEOUT_MS=8000
# ANALYZE_TIMEOUT_MS=4000
# ANALYZE_RACE_TIMEOUT_MS=3000
# ANALYZE_QUICK_TIMEOUT_MS=1500
# OPENER_TIMEOUT_MS=800

# ---------- Речь ----------
# LLM_PROVIDER=offline не отключает речь с уже заданными речевыми ключами.
# SPEECH=off                            # отключить живой синтез и распознавание
# По умолчанию синтез — SpeechKit (YANDEX_API_KEY с правами TTS); распознавание Яндекса — тот же ключ с правами STT.
# Для ElevenLabs выберите провайдер и настройте внешний воркер; ключ ElevenLabs хранится у воркера.
# TTS_PROVIDER=elevenlabs
# ELEVEN_RELAY_URL=https://your-worker.example
# ELEVEN_RELAY_SECRET=                  # должен совпадать с секретом воркера
# ELEVENLABS_MODEL=eleven_v4_turbo       # живые реплики по умолчанию
# ELEVEN_LIVE_V3=on                     # живые ответы лиц с настройкой v3 тоже на v3 (Эмре, Ли Вэй, Адебайо)
# ELEVEN_OPENER_FAST=on                 # вместе с ELEVEN_LIVE_V3=on оставляет заход на быстрой модели
# ELEVEN_LIVE_MODEL=eleven_v3_conversational  # вся живая реплика Эмре, Ли Вэя, Адебайо одной моделью (без шва); сильнее двух строк выше
# ELEVEN_CONCURRENCY=5
# ELEVEN_FIRST_BYTE_MS=2500             # таймаут первого звука, затем SpeechKit при наличии ключа
# ELEVEN_TIMEOUT_MS=15000
# ELEVEN_DAILY_CHARS=20000
# ELEVEN_SESSION_HOUR_LIMIT=60
# ELEVEN_IP_DAY_LIMIT=300                # на пропуск; общий потолок IP ×10
# TTS_YANDEX_API=v1                     # по умолчанию v3, v1 — запасной или явный выбор
# NATURAL_SPEECH=voices+                # livetts у лиц + ударения и паузы; значение по умолчанию

# Scribe автоматически включён с ELEVEN_RELAY_URL + ELEVEN_RELAY_SECRET, если SPEECH не off.
# При отказе потока полная запись идёт в Яндекс с хеджем (до двух запросов).
# STT_STREAM=off                        # только Яндекс; ?stt=off делает то же во вкладке, микрофон не отключает
STT_STREAM_VIA=server
# STT_STREAM_VIA=worker                 # прямой WebSocket браузера к воркеру, если прокси не пропускает Upgrade
# STT_ORIGIN=https://your-site.example  # точный публичный origin без слеша, нужен за HTTPS-прокси
# STT_STREAM_SESSION_HOUR_LIMIT=120
# STT_STREAM_IP_DAY_LIMIT=300
# STT_SCRIBE_USD_HOUR=0.39
# USD_RUB=100                           # расчётный курс, не обновляется автоматически
# Scribe заранее списывает слот 35 с (авто) или 65 с (кнопка), без возврата.
# Яндекс учитывает каждую начатую попытку, включая хедж/отмену, по блокам 15 с.

# ---------- Бюджет и квоты ----------
# Общий расчётный бюджет моделей и речи хранится в CACHE_DIR/usage/total.json.
# Это внутренний учёт, не лимит в кабинете поставщика; со 100% блокируются новые платные вызовы.
# LLM_TOTAL_RUB=6000
# LLM_DAILY_RUB=                         # отдельный суточный лимит моделей, по умолчанию без ограничения
# TTS_DAILY_CHARS=
# STT_DAILY_SEC=                         # Яндекс + зарезервированные секунды Scribe
# TTS_IP_DAY_LIMIT=
# STT_IP_DAY_LIMIT=
# SPEECH_DAY_LIMIT=
# TURN_SESSION_MINUTE_LIMIT=20          # только платные ходы
# GENERATE_SESSION_DAY_LIMIT=20
# PREPARE_SESSION_MINUTE_LIMIT=20
# LAB_IP_DAY_LIMIT=200
# LAB=off                               # отключить серверную лабораторию и выбор модели на запрос

# ---------- Сервер и доступ ----------
PORT=8787
# PORT для Vite передавайте также в окружение процесса: прокси не читает .env сервера.
# CACHE_DIR=.cache                      # кэш, свои дела, комнаты, расходы и votes.json
# ROOM_SESSION_DAY_LIMIT=50
# SHARE_SESSION_DAY_LIMIT=100
# ROOM_MAX_FILES=1000
# ROOM_MAX_BYTES=8388608
# SCENARIO_MAX_FILES=5000
# TRUSTED_PROXIES=127.0.0.1,::1         # реальные доверенные прокси через запятую; unix — для unix-сокета
# GATE_SECRET=                          # обязательный непустой секрет подписи cookie в production
# JURY_KEY=                             # общий ключ входа ?key=; не равен GATE_SECRET
# JURY_KEYS=                            # имя:ключ через запятую; битые пары пропускаются, первый корректный дубликат остаётся
# SITE_LOGIN=
# SITE_PASSWORD_HASH=                   # scrypt:<соль>:<хэш>, hashPassword в src/server/gate.ts
# ADMIN_KEY=                            # отдельный Bearer-ключ для GET /api/admin/jury; не передавать в URL

# Голосование за голоса: /golosa/<VOTE_KEY>, отдельный доступ, игру не открывает.
# Без VOTE_KEY страница выключена. Итоги: /golosa/<VOTE_KEY>/итоги, отдельный ключ вводится в форме.
# Используйте разные случайные секреты; ранее переданные в URL ключи администратора замените.
VOTE_KEY=
VOTE_ADMIN_KEY=
# Бланки: CACHE_DIR/votes.json, до 20 с IP в сутки и 2000 всего.
