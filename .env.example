# Какой LLM разбирает реплики и озвучивает оппонента:
#   yandex | anthropic | openai | claude-cli | offline
# offline — без сети: правила и шаблоны. Если ключей нет или провайдер падает, игра сама уходит в офлайн.
LLM_PROVIDER=offline

# YandexGPT (OpenAI-совместимый эндпоинт ai.api.cloud.yandex.net)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite         # для разработки; на проде yandexgpt-5.1 (Pro). Или полный gpt://<folder>/<model>
# YANDEX_FALLBACK_MODEL=yandexgpt-lite  # на неё сервер переходит с 80% суточного бюджета
# LLM_DAILY_RUB=150                  # суточный бюджет на модель; на 100% — офлайн-разметка и шаблоны
# YANDEX_PRICE_IN=0.8                # ₽ за 1000 токенов Pro, вход и выход
# YANDEX_PRICE_OUT=0.8
# YANDEX_LITE_PRICE_IN=0.2
# YANDEX_LITE_PRICE_OUT=0.2
# YANDEX_URL=https://ai.api.cloud.yandex.net/v1/chat/completions

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_BASE_URL=https://api.proxyapi.ru/anthropic   # с российского IP api.anthropic.com отвечает 403

# OpenAI (или любой совместимый прокси через OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # с российского IP — 403; прокси: https://api.proxyapi.ru/openai/v1

# claude-cli — локальный Claude Code по подписке, только для разработки
CLAUDE_CLI_MODEL=haiku
# CLAUDE_CLI_BIN=claude

# Сервер
PORT=8787
LLM_TIMEOUT_MS=25000
# CACHE_DIR=.cache                  # кэш ответов LLM, озвучки и сгенерированных сценариев

# Голос (Yandex SpeechKit, тот же YANDEX_API_KEY; роли ai.speechkit-tts.user и ai.speechkit-stt.user)
# SPEECH=off                         # выключить голос
# TTS_IP_DAY_LIMIT=400
# STT_IP_DAY_LIMIT=150
# SPEECH_DAY_LIMIT=5000
# TTS_DAILY_CHARS=40000              # символов озвучки в сутки на весь сервер
# STT_DAILY_SEC=3600                 # секунд распознавания в сутки
# TTS_YANDEX_API=v1                  # вернуть озвучку на SpeechKit v1 (по умолчанию v3; новые голоса есть только в v3)

# Лаборатория (/?lab) и сравнение голосов (/?voices): другие модели и голоса. Без ключа провайдер помечен «нужен ключ».
# LAB=off                            # выключить подмену модели из лаборатории
# LAB_IP_DAY_LIMIT=60                # ходов лаборатории на IP в сутки
# TTS_ALT_DAILY_CHARS=15000          # символов в сутки на чужие голоса (OpenAI, ElevenLabs, Salute)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts   # голос OpenAI (тот же OPENAI_API_KEY); tts-1 не понимает instructions
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # или eleven_flash_v2_5 — вдвое дешевле
# ELEVENLABS_VOICES=George:JBFqnCBsd6RMkjVDRZzb:m,Sarah:EXAVITQu4vr4xnSDxMaL:f
# Сбер: Authorization key из кабинета developers.sber.ru (base64 client_id:secret). Сертификат Минцифры уже в коде.
SALUTE_AUTH_KEY=
# SALUTE_SCOPE=SALUTE_SPEECH_PERS
GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2          # GigaChat-2-Pro, GigaChat-2-Max
# GIGACHAT_URL=https://api.giga.chat/v1/chat/completions
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1   # ElevenLabs закрыт для РФ — только через прокси
